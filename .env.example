# ── 필수 ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Instagram Graph API (비즈니스/크리에이터 계정 필요)
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAG...
# 페이스북 로그인으로 발급한 토큰이면 graph.facebook.com,
# 인스타그램 로그인으로 발급한 토큰이면 graph.instagram.com
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v23.0

# 이미지 공개 URL 호스팅: imgbb | github
IMAGE_HOST=imgbb
IMGBB_API_KEY=
# IMAGE_HOST=github 일 때 (공개 저장소여야 raw URL 접근 가능)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_IMAGE_BRANCH=images

# ── 선택 ──────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-5
# 한국어 폰트 경로 (없으면 시스템에서 자동 탐색)
FONT_PATH=fonts/NotoSansKR.ttf
# 기사 선정 후 웹 검색으로 사실 확인/보강
WEB_RESEARCH=true
# 인스타 계정 이름 (카드 하단 워터마크)
BRAND_HANDLE=@my_viral_story
